# Copy to terraform.tfvars and edit if you want different values.
# terraform.tfvars is gitignored. Never put AWS keys in here, they belong
# in the AWS CLI config or in environment variables.

region             = "ap-south-1"
project            = "washq"
owner              = "amrinder"
kubernetes_version = "1.31"
node_instance_type = "t3.medium"
node_desired_size  = 2
node_max_size      = 4
