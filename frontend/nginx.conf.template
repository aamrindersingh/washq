server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json;

    # Lets the container report healthy without touching the backend.
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # Single page app, so anything we do not recognise goes to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://${BACKEND_HOST}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /metrics {
        proxy_pass http://${BACKEND_HOST}/metrics;
    }

    location /health {
        proxy_pass http://${BACKEND_HOST}/health;
    }
}
